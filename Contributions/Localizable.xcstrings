    "widget-guide-step-1-subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold an empty area on your screen until your apps jiggle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén presionada la pantalla hasta que las aplicaciones se muevan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面上に何もない場所を\nアプリが動くまで長押しします"
          }
        }
      }
    },
    "widget-guide-step-2-subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the 'Edit' button in the upper-left corner to add new widgets."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa el botón 'Editar' en la esquina superior izquierda para añadir widgets."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいウィジェットを追加するには、左上隅の「編集」ボタンをタップします"
          }
        }
      }
    },
    "widget-guide-step-3-subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search for the 'Contributions' widget and tap the first result."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca por 'Contribuciones' y escoge el primer resultado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Contributions」を検索し、\n1件目をタップします"
          }
        }
      }
    },
    "widget-guide-step-4-subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe left and right to choose the widget's size and shape, then tap 'Add Widget'."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el tamaño del widget y luego pulsa 'Añadir widget'."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウィジェットのサイズを選択し、\n「ウィジェットを追加」をタップします"
          }
        }
      }
    },
    "widget-guide-step-5-subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the widget while it jiggles and you'll bring up the Widget settings menu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el widget mientras se mueve para abrir el menú de configuración."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像の状態でウィジェットをタップすると、\nウィジェットの設定メニューが表示されます"
          }
        }
      }
    },
    "widget-guide-step-6-subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjust the widget with your preferred GitHub username and theme color."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura el widget con el nombre de usuario de GitHub y color que prefieras."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHubのユーザー名とテーマカラーを設定します"
          }
        }
      }
    },
    "widget-guide-step-7-subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "... and, you're done! Enjoy your custom GitHub contributions widget!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "... ¡Listo! ¡Disfruta de tu widget de contribuciones de GitHub!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これで設定が完了です！"
          }
        }
      }
